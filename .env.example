# Basis-Konfiguration
APP_ENV=development
APP_URL=http://localhost:8000
SITE_URL=http://localhost:8000
DB_PATH=storage/database.sqlite

# Optional: Mail-Absender für Kontaktformulare
MAIL_FROM_NAME=FeroxZ CMS
MAIL_FROM_ADDRESS=no-reply@example.com

# Update-Steuerung (leer oder true = aktiviert; false = deaktiviert)
ENABLE_UPDATE=

# Sicherheit / Session
SESSION_NAME=feroxz_session

# Upload-Limits
MEDIA_MAX_SIZE_MB=20

# Import-Verzeichnis (Standard: storage/import_queue)
IMPORT_QUEUE_PATH=
